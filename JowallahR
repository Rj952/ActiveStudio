const COACH_SYSTEM = "You are an experienced university teaching consultant working with a lecturer on one week of their face-to-face course. "
  + "Be concrete and brief. Offer 3 to 5 options as short labelled bullets with a suggested number of minutes for each, "
  + "and state what evidence of learning each one produces and how it behaves at the class size given. "
  + "No preamble, no closing pep talk, no headings. Plain sentences. "
  + "Do not invent sources, statistics, authors or citations.";

async function runCoach(){
  const w = week();
  const bar = $("coachBar"), fill = bar.querySelector("i"), st = $("coachStatus");
  st.className = "status"; st.textContent = "Thinking…"; bar.classList.add("on"); fill.style.width="40%";
  $("btnCoachRun").disabled = true;
  const asks = {
    activities:"Suggest active-learning moves for this class.",
    questions:"Suggest a sharper essential question and the discussion prompts that follow from it.",
    exit:"Suggest exit tickets and quick checks for understanding.",
    misconceptions:"Name the likely student misconceptions here and how to surface them in class.",
    assessment:"Suggest assessment ideas aligned to these objectives.",
    local:"Suggest the kinds of Caribbean cases, data sources and community voices that would ground this topic. Name categories and where to look rather than specific figures you cannot verify.",
    large:"Rework this session so it works in a large room with fixed seats where students cannot move.",
    inclusion:"Suggest access, language and inclusion adjustments for this session, including for students who commute, work, or are reading in a second dialect or language."
  };
  const prompt = [
    asks[$("coachAsk").value],
    "",
    contextBlock(w),
    "",
    "Week " + w.no + " topic: " + (w.topic||"not set"),
    "Essential question: " + (w.question||"not set"),
    "Objectives:\n" + (w.objectives||"none listed"),
    "Readings:\n" + (w.readings||"none listed"),
    "Already planned:\n" + w.sequence.map(a=>"- "+a.min+" min "+a.title+" ("+(MODES[a.mode]||{}).label+", "+(GROUPS[a.group]||"")+")").join("\n"),
    w.personal.local ? "Local examples already in play: " + w.personal.local : "",
    $("coachContext").value ? ("Lecturer notes: " + $("coachContext").value) : "",
    "",
    CARIB_RULE
  ].filter(Boolean).join("\n");
  try {
    const out = await callClaude(COACH_SYSTEM, prompt, 1200);
