  $("dashBody").innerHTML =
    '<div class="dashgrid">'
    + tile(avgScore + "%", "Average teaching quality", done.length + " of " + ws.length + " weeks planned")
    + tile((totalMin ? Math.round(workMin/totalMin*100) : 0) + "%", "Of contact time, students working",
           workMin + " minutes across the term against " + listenMin + " minutes of transmission")
    + tile(evidenceWeeks + "/" + ws.length, "Weeks that collect evidence", "Exit tickets or named outputs from a task")
    + tile(localWeeks + "/" + ws.length, "Weeks with a local example", "Regional cases in your personal layer")
    + '</div>'
    + '<div class="dashgrid">'
    + '<div class="panel"><h5>Where the time goes, week by week</h5>'
      + '<p class="sublabel">Ochre is students working, pale is you talking, grey is opening and closing.</p>'+stack+'</div>'
    + '<div class="panel"><h5>Teaching quality by week</h5>'
      + '<p class="sublabel">Grey stubs are weeks with no topic yet.</p>'+scoreBars+'</div>'
    + '<div class="panel"><h5>Levels of thinking asked for</h5><p class="sublabel">'+esc(bloomNote)+'</p>'+bloomBars+'</div>'
    + '<div class="panel"><h5>Assessment load</h5><p class="sublabel">'+esc(loadNote)+'</p>'+loadBars+'</div>'
    + '<div class="panel"><h5>Reading load</h5><p class="sublabel">Items listed per week. Spikes are where students quietly stop reading.</p>'+readBars+'</div>'
    + '<div class="panel"><h5>Reflection captured</h5><p class="sublabel">'+reflectedWeeks+' of '+ws.length+' weeks have an after-class reflection. This is the single thing that makes next year\'s course better than this one, and the first thing a review panel asks to see.</p>'
      + '<div class="hbar"><span>Reflected</span><span class="track"><i style="width:'+Math.round(reflectedWeeks/ws.length*100)+'%"></i></span><span class="n">'+Math.round(reflectedWeeks/ws.length*100)+'%</span></div></div>'
    + '</div>';
