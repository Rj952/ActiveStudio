async function draftAllEmpty(){
  readForm();
  const targets = state.weeks.filter(unplanned);
  const st = $("planStatus"), bar = $("planBar"), fill = bar.querySelector("i");
  st.className = "status";
  if (!targets.length) { st.textContent = "Every week with a topic already has a plan. Nothing to draft."; return; }
  if (!confirm("Draft " + plural(targets.length, "unplanned week") + "? Existing plans, your layer and your room notes are left alone.")) return;
  bar.classList.add("on");
  const context = $("planContext").value, style = $("planStyle").value;
  const opts = {local: $("planLocal").checked, lowTech: $("planLowTech").checked};
  let done = 0, failed = 0;
  for (const w of targets) {
    st.textContent = "Drafting week " + pad(w.no) + " — " + (done+failed+1) + " of " + targets.length + "…";
    try {
      const p = await draftWeek(w, context, style, opts);
      if (!w.question && p.question) w.question = p.question;
      if (!w.objectives && p.objectives) w.objectives = p.objectives;
      if (!w.concepts && p.concepts) w.concepts = p.concepts;
      if (!w.exit && p.exit) w.exit = p.exit;
      if (!w.room.fallback && p.fallback) w.room.fallback = p.fallback;
      if (p.sequence.length) w.sequence = p.sequence;
      done++;
    } catch(e) { failed++; }
    fill.style.width = ((done+failed)/targets.length*100) + "%";
    await save();
    paintRail();
  }
  paintWeek();
  st.textContent = plural(done, "week") + " drafted" + (failed ? ", " + failed + " could not be reached" : "") + ". Read each one before you teach it.";
}

