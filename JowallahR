const LIB_FILTERS = [
  {k:"fits",   label:"Fits my room and class", test:m => (!m.max || m.max >= seatsFor(week())) && (roomFor(week())!=="tiered" || m.fixed)},
  {k:"notech", label:"No technology needed",   test:m => !m.tech},
  {k:"large",  label:"Works with 100+",        test:m => !m.max || m.max >= 100},
  {k:"short",  label:"Under 15 minutes",       test:m => m.m <= 15},
  {k:"writes", label:"Leaves written evidence",test:m => m.writes},
  {k:"local",  label:"Caribbean grounded",     test:m => (m.tags||[]).indexOf("Caribbean") > -1}
];
let libOn = {};
function paintLibrary(){
  $("libFilters").innerHTML = LIB_FILTERS.map(f=>
    '<button class="chip'+(libOn[f.k]?" on":"")+'" type="button" data-f="'+f.k+'">'+f.label+'</button>').join("");
  $("libFilters").querySelectorAll(".chip").forEach(b=>b.onclick=()=>{
    libOn[b.dataset.f] = !libOn[b.dataset.f];
    paintLibrary();
  });
  const q = ($("libSearch").value||"").toLowerCase().trim();
  const rows = LIBRARY.filter(m=>{
    for (const f of LIB_FILTERS) if (libOn[f.k] && !f.test(m)) return false;
    if (!q) return true;
    return (m.n + " " + m.d + " " + m.ev + " " + (m.tags||[]).join(" ")).toLowerCase().indexOf(q) > -1;
  });
  $("libList").innerHTML = rows.map((m)=>{
    const i = LIBRARY.indexOf(m);
    const mode = MODES[m.mode] || MODES.active;
    const flags = [
      '<span class="tag src">'+mode.label+'</span>',
      '<span class="tag you">'+m.m+' min</span>',
      '<span class="tag you">'+GROUPS[m.group]+'</span>',
      m.tech ? '<span class="tag bad">needs tech</span>' : '<span class="tag sea">no tech</span>',
      m.max ? '<span class="tag you">up to '+m.max+'</span>' : '<span class="tag sea">any size</span>',
      m.fixed ? '' : '<span class="tag edit">needs movable seats</span>'
    ].filter(Boolean).join(" ");
    return '<div class="move">'
      + '<div class="mh"><h5>'+esc(m.n)+'</h5><button class="btn small" type="button" data-add="'+i+'">Insert</button></div>'
      + '<p class="md">'+esc(m.d)+'</p>'
      + '<p class="md"><strong>Evidence:</strong> '+esc(m.ev)+'</p>'
      + '<div class="mt">'+flags+'</div></div>';
  }).join("") || '<p class="hint" style="padding:14px">Nothing matches those filters. Turn one off.</p>';
  $("libStatus").textContent = rows.length + " of " + LIBRARY.length + " moves shown · room set to "
