/* ============================================================
   Bloom's detection and the offline teaching quality check
   ============================================================ */

function bloomOf(line){
  let t = String(line||"").toLowerCase().replace(/^[\s\-•*•–\d.)]+/,"").trim();
  let prev;
  do { prev = t; t = t.replace(STOP_STEMS,"").trim(); } while (t !== prev && t);
  const first = (t.split(/[^a-z]+/).filter(Boolean)[0]) || "";
  if (!first) return null;
  for (const b of BLOOM) if (b.verbs.indexOf(first) > -1) return b;
  return null;
}
function bloomsIn(text){
  return lines(text).map(l=>({line:l, bloom:bloomOf(l)}));
}

const STOPWORDS = new Set(("the a an and or of to in on for with by from as at is are was were be been being "
 + "their they them this that these those will would can could should shall must students student learners learner "
 + "able week course class about into over under between more most other such not only own same than too very "
 + "using use used within across through each any some what which when where while also given upon toward towards").split(/\s+/));
function stem(x){ return x.replace(/ies$/,"y").replace(/(ings|ing|edly|ed|es|s)$/,""); }
function keywords(s){
  const out = new Set();
  String(s||"").toLowerCase().split(/[^a-z]+/).forEach(w=>{
    if (w.length >= 4 && !STOPWORDS.has(w)) out.add(stem(w));
  });
  return out;
}
function timeProfile(w){
  const seq = w.sequence || [];
  const total = seq.reduce((s,a)=>s+(a.min||0),0);
  const by = {frame:0, listen:0, work:0};
  seq.forEach(a=>{ const k = (MODES[a.mode]||MODES.input).kind; by[k] += (a.min||0); });
  return {
    total, frame:by.frame, listen:by.listen, work:by.work,
    workPct: total ? by.work/total*100 : 0,
    listenPct: total ? by.listen/total*100 : 0
  };
}
/* which objectives are actually touched by something that happens in the room */
function alignment(w){
  const objs = lines(w.objectives);
  if (!objs.length) return {objs:[], orphans:[], pct:0};
  const sessionText = (w.sequence||[]).map(a=>a.title + " " + a.notes + " " + a.evidence).join(" ")
    + " " + (w.exit||"") + " " + (w.question||"") + " " + (w.concepts||"");
  const pool = keywords(sessionText);
  const orphans = [];
  objs.forEach(o=>{
    const ks = [...keywords(o)];
    const hit = ks.length ? ks.some(k=>pool.has(k)) : false;
    if (!hit) orphans.push(o);
  });
  return {objs, orphans, pct: Math.round((objs.length-orphans.length)/objs.length*100)};
}
function planned(w){
  return !!(w.topic && w.topic.trim()) && (w.sequence||[]).some(a=>a.notes && a.notes.trim());
}

/* The check itself. Everything here is computed locally, in a millisecond, with no network. */
function analyse(w){
  const checks = [];
  const add = (level, title, detail) => checks.push({level, title, detail});
  const t = timeProfile(w);
  const target = state.course.minutes || 90;
  const seq = w.sequence || [];
  const objs = lines(w.objectives);
  const seats = seatsFor(w);
  const room = roomFor(w);
  const tech = state.course.tech || "patchy";
  const al = alignment(w);
  const bl = bloomsIn(w.objectives);
  const topBloom = bl.map(b=>b.bloom).filter(Boolean).sort((a,b)=>b.rank-a.rank)[0];

  /* 1. the spine */
  if (!w.topic || !w.topic.trim()) add("bad","No topic yet","Give the week a topic and everything else in this panel becomes meaningful.");
  else add("ok","Topic set", w.topic.trim());

  if (!w.question || !w.question.trim())
    add("warn","No essential question","One arguable question per session gives students something to hold on to and gives you a way to close. Write the question they should be able to answer on the way out.");
  else if (!/[?]/.test(w.question))
    add("warn","The essential question is not a question","Phrase it as a question students could genuinely argue either way, not as a statement of the topic.");
  else add("ok","Essential question set", w.question.trim());

  /* 2. objectives and Bloom's */
  if (!objs.length) add("bad","No learning objectives","Without objectives nothing else can be aligned to anything. Three to five is usually right for one session.");
  else {
    const noVerb = bl.filter(b=>!b.bloom).map(b=>b.line);
    if (objs.length > 6)
      add("warn", objs.length + " objectives for one session","Five is a lot for ninety minutes and six is usually a list of topics wearing a costume. Fold them together or move some to the following week.");
    else add("ok", objs.length + " learning objectives", "");

    if (noVerb.length)
      add("warn", noVerb.length + " objective" + (noVerb.length>1?"s do":" does") + " not start with an action verb",
          "An objective a student cannot be observed doing cannot be assessed. Rewrite: “" + noVerb[0].slice(0,70) + "”");
    else add("ok","Every objective starts with an action verb","");

    if (topBloom && topBloom.rank <= 2)
      add("warn","Everything sits at recall and understanding",
          "The highest level you ask for this week is " + topBloom.label.toLowerCase() + ". At this level students can pass without being able to use any of it. Push at least one objective to apply, analyse or evaluate.");
    else if (topBloom)
      add("ok","Reaches " + topBloom.label.toLowerCase() + " level thinking","");
  }

  /* 3. the shape of the session */
  if (!t.total) add("bad","The session has no minutes in it","Add the moves that make up the class.");
  else {
    if (Math.abs(t.total-target) > Math.max(6, target*0.1))
      add("warn","The sequence runs " + (t.total>target ? (t.total-target) + " minutes long" : (target-t.total) + " minutes short"),
          "You have planned " + t.total + " minutes for a " + target + " minute class. Overrunning plans get cut from the end, which is where the consolidation lives. Use Rebalance to fix it.");
    else add("ok","Timing fits the class length", t.total + " of " + target + " minutes planned");

    if (t.workPct < 25)
      add("bad","Students are working for only " + Math.round(t.workPct) + "% of the class",
          "Below a quarter, this is a lecture with pauses. Aim for at least 45%: swap one input block for a task from the move library.");
    else if (t.workPct < 45)
      add("warn","Students are working for " + Math.round(t.workPct) + "% of the class",
          "Respectable, not yet active. Getting past 45% is usually one swap: turn your longest input block into a think-pair-share or a worked-example-then-fade.");
    else add("ok", Math.round(t.workPct) + "% of the class is students working","");

    if (t.listenPct > 50)
      add("bad","You are talking for " + Math.round(t.listenPct) + "% of the class",
          "Attention to continuous exposition falls away sharply after ten to fifteen minutes. Break the input into shorter pieces with something to do between them.");
    else if (t.listenPct > 33)
      add("warn","You are talking for " + Math.round(t.listenPct) + "% of the class",
          "A third is about the ceiling if the session is to stay active. Trim the input, or fold part of it into a guided task.");
    else add("ok","Transmission is held to " + Math.round(t.listenPct) + "% of the class","");

    const longest = seq.filter(a=>(MODES[a.mode]||{}).kind==="listen").sort((a,b)=>b.min-a.min)[0];
    if (longest && longest.min > 20)
      add("warn","One unbroken input block of " + longest.min + " minutes","“" + (longest.title||"that block") + "” runs past the point where most of the room has stopped following. Split it, or insert a two-minute pause procedure in the middle.");

    const hasOpen = seq.some(a=>a.mode==="open");
    const hasClose = seq.some(a=>a.mode==="close" || a.mode==="check");
    if (!hasOpen) add("warn","Nothing opens the session","The first five minutes decide whether the rest lands. Surface prior knowledge, or start from something they saw this week.");
    if (!hasClose) add("bad","Nothing closes the session","Without a consolidation move you finish on whatever the clock lands on and you leave with no evidence.");
    if (hasOpen && hasClose) add("ok","The session opens and closes deliberately","");
  }

  /* 4. evidence */
  const withEvidence = seq.filter(a=>a.evidence && a.evidence.trim()).length;
  const hasExit = !!(w.exit && w.exit.trim());
  if (!withEvidence && !hasExit)
    add("bad","No evidence of learning is collected","You will leave the room with an impression rather than a finding. Name what each task produces, and write an exit ticket.");
  else if (withEvidence < 2 || !hasExit)
    add("warn","Evidence is thin","" + (hasExit ? "You have an exit ticket" : "No exit ticket yet") + " and " + withEvidence + " move" + (withEvidence===1?"":"s") + " with the evidence named. Two or three collection points across the session is the usual minimum a reviewer looks for.");
  else add("ok","Evidence collected at " + withEvidence + " points, plus an exit ticket","");

  /* 5. alignment */
  if (objs.length && seq.length) {
    if (al.orphans.length)
      add(al.orphans.length === objs.length ? "bad" : "warn",
          al.orphans.length + " objective" + (al.orphans.length>1?"s are":" is") + " never practised in class",
          "Nothing in the sequence, the exit ticket or the essential question touches: “" + al.orphans[0].slice(0,80) + "”. Either build a move for it or move it out of this week.");
    else add("ok","Every objective is practised in the room","");
  }
  if (lines(w.assessment).length) {
    const pool = keywords(seq.map(a=>a.title+" "+a.notes).join(" ") + " " + w.exit);
    const aKeys = [...keywords(w.assessment)];
    const touched = aKeys.length ? aKeys.some(k=>pool.has(k)) : false;
    if (!touched)
      add("warn","The assessment is not rehearsed in class","Something is due or in progress this week but nothing in the session prepares for it. Ten minutes of the real task, with feedback, is worth more than any reminder.");
    else add("ok","Class time rehearses the assessment in play","");
  }

  /* 6. the room */
  const groupsUsed = new Set(seq.map(a=>a.group));
  if (seq.length >= 3 && groupsUsed.size === 1)
    add("warn","Every move uses the same grouping","The whole class in one configuration for ninety minutes flattens participation. Vary between individual thinking, pairs and small groups.");
  else if (seq.length >= 3) add("ok","Grouping varies across the session","");

  if (room === "tiered" && seq.some(a=>a.group === "small") && !(w.room && w.room.groups && w.room.groups.trim()))
    add("warn","Small groups in fixed tiered seating","Say how groups form when nobody can move: threes along a row, or a row talking to the row in front. Written down now, it takes ten seconds in the room.");

  if (seats >= 60) {
    const okAtScale = seq.filter(a=>a.group==="pairs" || a.group==="individual" || a.group==="whole").length;
    if (okAtScale < seq.length/2)
      add("warn","Most moves assume a small room, but you expect " + seats + " students",
          "At this size, pair work, voting and written slips scale; free-forming small groups and full-class discussion do not. The move library can filter for large classes.");
    else add("ok","The moves scale to " + seats + " students","");
  }

  const techMins = seq.filter(a=>a.tech).reduce((s,a)=>s+(a.min||0),0);
  if (tech !== "good" && t.total && techMins/t.total > 0.5 && !(w.room && w.room.fallback && w.room.fallback.trim()))
    add("warn", Math.round(techMins/t.total*100) + "% of the class depends on technology you cannot rely on",
        "You have recorded the room as “" + TECHS[tech].toLowerCase() + "”. Write the board-and-paper version of this session in the fallback box, once, and stop improvising it.");
  else if (w.room && w.room.fallback && w.room.fallback.trim())
    add("ok","A low-technology fallback is written down","");

  /* 7. inclusion, and the layer that makes it yours */
  if (!(w.personal.adapt||"").trim())
    add("warn","No adjustments recorded for this group","Note the access, language and pacing decisions you are making, even briefly. It is the first thing an inclusion review asks for and the first thing you forget by next year.");
  else add("ok","Adjustments for this group are recorded","");

  if (!(w.personal.local||"").trim() && (state.course.country && state.course.country !== "Outside the Caribbean"))
    add("warn","No local or regional example yet","A week taught entirely from imported cases teaches students that the important examples happen elsewhere. One local case is enough to change that.");
  else if ((w.personal.local||"").trim()) add("ok","Grounded in local and lived examples","");

  if (!lines(w.readings).length)
    add("warn","No readings or resources listed","Even one anchor text per week gives students somewhere to go when the session moves faster than they do.");

  /* score */
  const weight = {ok:1, warn:0.5, bad:0};
  const scored = checks.filter(c=>c.level!=="info");
  const score = scored.length ? Math.round(scored.reduce((s,c)=>s+weight[c.level],0)/scored.length*100) : 0;
  const verdict = !w.topic || !w.topic.trim() ? "not planned"
    : score >= 85 ? "ready to teach"
    : score >= 70 ? "solid, small fixes"
    : score >= 50 ? "needs work"
    : "early draft";

  const bars = [
    {label:"Students working", pct: Math.round(t.workPct),   good: t.workPct >= 45,  color: t.workPct >= 45 ? MODES.active.color : (t.workPct >= 25 ? "#C79A4E" : "#A2402C"), note: Math.round(t.workPct)+"%"},
    {label:"You talking",      pct: Math.round(t.listenPct), good: t.listenPct <= 33, color: t.listenPct <= 33 ? MODES.open.color : (t.listenPct <= 50 ? "#C79A4E" : "#A2402C"), note: Math.round(t.listenPct)+"%"},
    {label:"Objectives met",   pct: al.pct,                  good: al.pct >= 100,     color: al.pct >= 100 ? MODES.open.color : (al.pct >= 60 ? "#C79A4E" : "#A2402C"), note: (al.objs.length - al.orphans.length) + "/" + al.objs.length},
    {label:"Evidence points",  pct: Math.min(100,(withEvidence + (hasExit?1:0))/3*100), good: (withEvidence + (hasExit?1:0)) >= 3, color: (withEvidence+(hasExit?1:0)) >= 3 ? MODES.check.color : "#C79A4E", note: String(withEvidence + (hasExit?1:0))}
  ];

  return {score, verdict, checks, bars, time:t, alignment:al, blooms:bl, topBloom, seats, evidencePoints: withEvidence + (hasExit?1:0)};
}

