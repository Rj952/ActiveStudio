function insertMove(i){
  const m = LIBRARY[i];
  readForm();
  const w = week();
  const closeIdx = w.sequence.findIndex(a=>a.mode==="close");
  const item = {min:m.m, title:m.n, mode:m.mode, group:m.group, notes:m.d, evidence:m.ev, tech:!!m.tech};
  if (m.mode === "close" || closeIdx < 0) w.sequence.push(item);
  else w.sequence.splice(closeIdx, 0, item);
  paintActivities(); onEdit();
  toast('"' + m.n + '" added to week ' + pad(w.no) + '. Rebalance if you are now over time.');
}

