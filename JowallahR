   Painting
   ============================================================ */
function completeness(w){
  const checks = [
    w.topic, w.question, w.objectives, w.readings,
    (w.sequence||[]).some(a=>a.notes && a.notes.trim()) ? "y" : "",
    (w.sequence||[]).some(a=>a.evidence && a.evidence.trim()) || w.exit ? "y" : "",
    w.exit,
    (w.personal.hook || w.personal.local || w.personal.adapt || w.personal.materials || w.personal.notes),
    (w.after.notes || w.after.reflect || w.after.bridge || w.after.evidence)
  ];
  const done = checks.filter(x => x && String(x).trim()).length;
  return Math.round(done / checks.length * 100);
}
function ring(pct, on){
  const r = 10, c = 2*Math.PI*r, off = c*(1-pct/100);
  const col = on ? "#1C6B5B" : "#9DB6AE";
  return '<svg class="ring" viewBox="0 0 26 26" aria-hidden="true">'
    + '<circle cx="13" cy="13" r="'+r+'" fill="none" stroke="#D9E2DC" stroke-width="3"/>'
    + '<circle cx="13" cy="13" r="'+r+'" fill="none" stroke="'+col+'" stroke-width="3" stroke-linecap="round" '
    + 'stroke-dasharray="'+c.toFixed(1)+'" stroke-dashoffset="'+off.toFixed(1)+'" transform="rotate(-90 13 13)"/></svg>';
}
function paintRail(){
  const list = $("weekList");
  list.innerHTML = state.weeks.map((w,i)=>{
    const on = (i+1)===state.selected;
    const tp = w.topic && w.topic.trim() ? esc(w.topic) : '<span style="color:#8B9A95">Not planned yet</span>';
    return '<button class="wk'+(on?" on":"")+'" data-week="'+(i+1)+'" type="button">'
      + ring(completeness(w), on)
      + '<span><span class="no">Week '+pad(i+1)+'</span><br><span class="tp">'+tp+'</span></span></button>';
  }).join("");
  list.querySelectorAll(".wk").forEach(b=>b.onclick=()=>selectWeek(+b.dataset.week));
  const avg = Math.round(state.weeks.reduce((s,w)=>s+completeness(w),0)/state.weeks.length);
  const ready = state.weeks.filter(planned).length;
  $("railStat").textContent = ready + " of " + plural(state.weeks.length, "week") + " planned · " + avg + "% complete";
  const scored = state.weeks.filter(w=>w.topic && w.topic.trim()).map(w=>analyse(w).score);
  $("railQuality").textContent = scored.length
    ? "Teaching quality " + Math.round(scored.reduce((a,b)=>a+b,0)/scored.length) + "% across planned weeks"
    : "Quality score appears once a week has a topic";
}
function paintRibbon(){
  const w = week();
  const total = w.sequence.reduce((s,a)=>s+(a.min||0),0) || 1;
  $("ribbon").innerHTML = w.sequence.map(a=>{
    const m = MODES[a.mode] || MODES.input;
    const pctv = (a.min||0)/total*100;
    const label = pctv > 9 ? (a.min+"m") : "";
    return '<div class="seg" style="width:'+pctv+'%;background:'+m.color+'" title="'+esc(a.title)+' — '+a.min+' min, '+m.label+'">'+label+'</div>';
  }).join("");
  $("legend").innerHTML = Object.keys(MODES).map(k=>'<span title="'+esc(MODES[k].blurb)+'"><i style="background:'+MODES[k].color+'"></i>'+MODES[k].label+'</span>').join("");
  const mins = w.sequence.reduce((s,a)=>s+(a.min||0),0);
  const target = state.course.minutes || 90;
  const over = mins - target;
  $("minuteCount").textContent = mins + " of " + target + " min" + (Math.abs(over) >= 5 ? (over>0 ? " · " + over + " over" : " · " + (-over) + " spare") : " · on time");
}
function paintActivities(){
  const w = week();
  $("activities").innerHTML = w.sequence.map((a,i)=>{
    const opts = Object.keys(MODES).map(k=>'<option value="'+k+'"'+(a.mode===k?" selected":"")+'>'+MODES[k].label+'</option>').join("");
    const gopts = Object.keys(GROUPS).map(k=>'<option value="'+k+'"'+(a.group===k?" selected":"")+'>'+GROUPS[k]+'</option>').join("");
    const col = (MODES[a.mode]||MODES.input).color;
    return '<div class="act" data-i="'+i+'" style="border-left-color:'+col+'">'
      + '<div class="row1">'
      + '<input class="t m" type="number" min="0" step="5" value="'+(a.min||0)+'" aria-label="Minutes">'
      + '<input class="t ti" value="'+esc(a.title)+'" aria-label="What happens">'
      + '<select class="t md" aria-label="Type of move">'+opts+'</select>'
      + '<select class="t gp" aria-label="Grouping">'+gopts+'</select>'
      + '<span class="mv noprint">'
      + '<button class="iconbtn up" type="button" title="Move earlier" aria-label="Move earlier">&#8593;</button>'
      + '<button class="iconbtn down" type="button" title="Move later" aria-label="Move later">&#8595;</button>'
      + '<button class="iconbtn del" type="button" title="Remove" aria-label="Remove">&#215;</button></span>'
      + '</div>'
      + '<textarea class="t nt" style="margin-top:9px" placeholder="What you do, what students do, the prompt, how groups form" aria-label="Detail">'+esc(a.notes)+'</textarea>'
      + '<div class="row2">'
      + '<input class="t ev" value="'+esc(a.evidence)+'" placeholder="Evidence this produces: slips collected, board work, vote split, drafts&hellip;" aria-label="Evidence produced">'
      + '<label class="techbox"><input type="checkbox" class="tc"'+(a.tech?" checked":"")+'> needs power or internet</label>'
      + '</div>'
      + '</div>';
  }).join("");
  $("activities").querySelectorAll(".act").forEach(el=>{
    const i = +el.dataset.i;
    el.querySelectorAll("input,textarea,select").forEach(x=>{
      x.oninput = onEdit;
      x.onchange = ()=>{ onEdit(); if (x.classList.contains("md")) paintActivities(); };
    });
    el.querySelector(".up").onclick = ()=>moveAct(i,-1);
    el.querySelector(".down").onclick = ()=>moveAct(i,1);
    el.querySelector(".del").onclick = ()=>{ readForm(); week().sequence.splice(i,1); paintActivities(); onEdit(); };
  });
}
function moveAct(i,d){
  readForm();
  const s = week().sequence, j = i+d;
  if (j<0 || j>=s.length) return;
  const tmp = s[i]; s[i] = s[j]; s[j] = tmp;
  paintActivities(); onEdit();
}
/* stretch or shrink the sequence to the real class length, in five-minute steps */
function rebalance(){
  readForm();
  const w = week();
  const target = state.course.minutes || 90;
  const seq = w.sequence.filter(a=>a.min > 0);
  if (!seq.length) { toast("Give the moves some minutes first"); return; }
  const total = seq.reduce((s,a)=>s+a.min,0);
  let running = 0;
  seq.forEach((a,i)=>{
    a.min = (i === seq.length-1) ? Math.max(0, target-running) : Math.max(5, Math.round(a.min*target/total/5)*5);
    running += a.min;
  });
  w.sequence = seq;
  paintActivities(); onEdit();
  toast("Rebalanced to " + target + " minutes");
}
function badge(current, importedVal, restoreKey){
  if (importedVal == null || importedVal === "") return '<span class="tag you">yours</span>';
  if (String(current).trim() === String(importedVal).trim()) return '<span class="tag src">from outline</span>';
  return '<span class="tag edit">edited</span> <button class="linkbtn noprint" type="button" data-restore="'+restoreKey+'">restore outline text</button>';
}
function paintBadges(){
  const w = week(), im = w.imported;
  $("badgeObj").innerHTML  = badge(w.objectives, im && im.objectives, "objectives");
  $("badgeRead").innerHTML = badge(w.readings,   im && im.readings,   "readings");
  $("badgeAss").innerHTML  = badge(w.assessment, im && im.assessment, "assessment");
  $("frameBadges").innerHTML = im ? '<span class="tag src">imported '+esc(im.when||"")+'</span>' : '';
  document.querySelectorAll("[data-restore]").forEach(b=>{
    b.onclick = ()=>{
      readForm();
      const k = b.dataset.restore;
      week()[k] = week().imported[k];
      paintWeek(); toast("Outline text restored");
      queueSave();
    };
  });
  /* Bloom's strip under the objectives */
  const bl = bloomsIn(w.objectives);
  $("bloomStrip").innerHTML = bl.length
    ? bl.map(b=> b.bloom
        ? '<span class="bl" title="'+esc(b.line)+'">'+b.bloom.label+'</span>'
        : '<span class="bl none" title="'+esc(b.line)+'">no action verb</span>').join("")
    : "";
}
function paintQuality(){
  const w = week();
  const a = analyse(w);
  $("qScore").textContent = (w.topic && w.topic.trim()) ? a.score + "%" : "—";
  $("qVerdict").textContent = a.verdict;
  $("qScore").style.color = a.score >= 85 ? "var(--leaf)" : a.score >= 70 ? "var(--leaf-deep)" : a.score >= 50 ? "var(--ochre)" : "var(--rust)";
  $("qBars").innerHTML = a.bars.map(b=>
    '<div class="qbar"><span>'+b.label+'</span>'
    + '<span class="meter"><i style="width:'+clamp(b.pct,0,100)+'%;background:'+b.color+'"></i></span>'
    + '<span class="stat" style="text-align:right">'+esc(b.note)+'</span></div>').join("");
  const order = {bad:0, warn:1, ok:2};
  const icons = {bad:"✕", warn:"!", ok:"✓"};
  $("qChecks").innerHTML = a.checks.slice().sort((x,y)=>order[x.level]-order[y.level]).map(c=>
    '<div class="check '+c.level+'"><span class="ic" aria-hidden="true">'+icons[c.level]+'</span>'
    + '<span><span class="ttl">'+esc(c.title)+'</span>'
    + (c.detail ? '<br><span class="dt">'+esc(c.detail)+'</span>' : '')+'</span></div>').join("");
}
function paintWeek(){
  const w = week();
  $("weekEyebrow").textContent = "Week " + pad(w.no) + " of " + pad(state.weeks.length);
  FIELDS.forEach(([id,k])=> $(id).value = w[k] || "");
  RFIELDS.forEach(([id,k])=> $(id).value = (w.room && w.room[k]) || "");
  PFIELDS.forEach(([id,k])=> $(id).value = w.personal[k] || "");
  AFIELDS.forEach(([id,k])=> $(id).value = w.after[k] || "");
  $("wSeats").placeholder = "Course default: " + (state.course.size || 35);
  paintActivities(); paintRibbon(); paintBadges(); paintQuality(); paintRail();
}
function paintCourse(){
