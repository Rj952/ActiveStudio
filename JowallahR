       '<tr><td class="min">'+pad(w.no)+'</td><td>'+esc(w.after.reflect || w.after.notes)+'</td>'
       + '<td>'+esc(w.after.evidence||"—")+'</td></tr>').join("");
     const n = state.weeks.filter(w=>(w.after.reflect||"").trim()).length;
     return '<p>Post-session reflection is recorded for '+n+' of '+state.weeks.length+' weeks, with the evidence of learning collected alongside it.</p>'
       + (rows ? '<table><thead><tr><th>Week</th><th>Reflection</th><th>Evidence collected</th></tr></thead><tbody>'+rows+'</tbody></table>'
               : '<p><em>Nothing recorded yet. This is the section reviewers read most closely, and it is the cheapest one to fill: a sentence per week, on the day.</em></p>');
   }}
];
function qaDocument(){
  const c = state.course;
  const scores = state.weeks.filter(w=>(w.topic||"").trim()).map(w=>analyse(w).score);
  const avg = scores.length ? Math.round(scores.reduce((a,b)=>a+b,0)/scores.length) : 0;
  const body = QA_AREAS.map((a,i)=>
    '<section><h3>'+(i+1)+'. '+esc(a.t)+'</h3>'
    + '<p class="sub" style="text-transform:none;letter-spacing:0;font-size:13px"><em>'+esc(a.ask)+'</em></p>'
    + a.ev() + '</section>').join("");
  return '<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Quality dossier &mdash; '+esc(c.title||"Course")+'</title><style>'+DOC_CSS+'</style></head><body>'
    + '<h1>Course quality dossier</h1>'
    + '<h2>'+esc(c.title||"Untitled course")+'</h2>'
    + '<div class="sub">'+courseHeaderBits()+'</div>'
    + '<div class="sub">Prepared '+new Date().toLocaleDateString()
      + (c.qa ? ' &middot; for ' + esc(QA_BODIES[c.qa]||c.qa) : '') + '</div>'
    + '<div class="note"><strong>How to read this.</strong> The headings below are the quality areas that Caribbean accreditation and internal review panels ask about in some form &mdash; UCJ, ACTT, BAC, the national councils, and institutional self-studies all cover this ground under their own numbering. '
    + 'Check the current handbook of your own body for their exact wording and order, then move this evidence under it. Everything here is generated from your own weekly plans; nothing has been added.</div>'
    + '<p><strong>Summary.</strong> '+plural(state.weeks.length,'week')+' planned, average teaching quality score '+avg+'% on the internal active-learning and alignment check, '
    + state.weeks.filter(planned).length+' with a complete session plan.</p>'
    + body + '</body></html>';
}

/* ---------- the outcome map, for spreadsheets ---------- */
function toCSV(weeks){
  const q = s => '"' + String(s==null?"":s).replace(/"/g,'""').replace(/\r?\n/g,"; ") + '"';
  const head = ["Week","Topic","Essential question","Objective","Bloom level","Teaching moves","Evidence collected","Exit ticket","Assessment","Readings","Minutes","Students working %","Quality score"];
  const rows = [head.map(q).join(",")];
  weeks.forEach(w=>{
    const t = timeProfile(w);
    const a = (w.topic||"").trim() ? analyse(w) : null;
    const moves = (w.sequence||[]).map(x=>x.min+"m "+x.title).join("; ");
    const ev = (w.sequence||[]).map(x=>x.evidence).filter(Boolean).join("; ");
    const objs = bloomsIn(w.objectives);
    const base = [w.no, w.topic, w.question];
    const tail = [moves, ev, w.exit, lines(w.assessment).join("; "), lines(w.readings).join("; "),
                  t.total, Math.round(t.workPct), a ? a.score : ""];
    if (!objs.length) rows.push([...base, "", ""].concat(tail).map(q).join(","));
    else objs.forEach(o=>rows.push([...base, o.line, o.bloom ? o.bloom.label : "no action verb"].concat(tail).map(q).join(",")));
  });
  return rows.join("\r\n");
}
function toMarkdown(weeks, withPersonal){
  const c = state.course;
  const list = weeks || state.weeks;
  const keepMine = withPersonal !== false;
  let out = "# " + (c.title||"Course") + "\n";
  const bits = [c.code,c.term,c.level,c.institution,c.country].filter(Boolean).join(" · ");
  if (bits) out += "_" + bits + "_\n";
  out += "\nFace to face · " + (c.minutes||90) + " minute sessions · about " + (c.size||35) + " students · " + (ROOMS[c.room]||"") + "\n";
  list.forEach(w=>{
    const t = timeProfile(w);
    out += "\n\n## Week " + pad(w.no) + (w.topic ? " — " + w.topic : "") + "\n";
    if (w.question) out += "\n**Essential question:** " + w.question + "\n";
    const bl = (title,v)=> v && v.trim() ? "\n**"+title+"**\n" + lines(v).map(l=>"- "+l).join("\n") + "\n" : "";
    out += bl("Objectives", w.objectives);
    out += bl("Readings", w.readings);
    out += bl("Assessment", w.assessment);
    if (w.concepts) out += "\n**Watch for:** " + w.concepts + "\n";
    out += "\n**Class plan** — " + t.total + " minutes, " + (t.total?Math.round(t.workPct):0) + "% students working\n\n";
    out += "| Min | Move | Type | Grouping | Evidence | Notes |\n|---|---|---|---|---|---|\n";
    w.sequence.forEach(a=>{
      const cell = s => String(s||"").replace(/\n/g,"<br>").replace(/\|/g,"/");
      out += "| " + (a.min||0) + " | " + cell(a.title) + " | " + ((MODES[a.mode]||{}).label||"") + " | "
           + (GROUPS[a.group]||"") + " | " + cell(a.evidence) + " | " + cell(a.notes) + " |\n";
    });
    if (w.exit) out += "\n**Exit ticket:** " + w.exit + "\n";
    const rm = w.room||{};
    if (rm.groups || rm.fallback || rm.seats || rm.room) {
      out += "\n**Room**\n";
      if (rm.seats) out += "- Students expected: " + rm.seats + "\n";
      if (rm.room) out += "- Room: " + (ROOMS[rm.room]||rm.room) + "\n";
      if (rm.groups) out += "- Groups: " + rm.groups + "\n";
      if (rm.fallback) out += "- If the technology fails: " + rm.fallback + "\n";
    }
    const p = w.personal;
    if (keepMine && (p.hook||p.local||p.adapt||p.materials||p.notes)) {
      out += "\n**My layer**\n";
      if (p.hook) out += "- Hook: " + p.hook + "\n";
      if (p.local) out += "- Local examples: " + p.local + "\n";
      if (p.adapt) out += "- Adjustments: " + p.adapt + "\n";
      if (p.materials) out += "- Materials: " + p.materials + "\n";
      if (p.notes) out += "- Notes: " + p.notes + "\n";
    }
    const a2 = w.after;
    if (keepMine && (a2.notes||a2.evidence||a2.reflect||a2.bridge)) {
      out += "\n**After class**\n";
      if (a2.notes) out += "- What happened: " + a2.notes + "\n";
      if (a2.evidence) out += "- Evidence collected: " + a2.evidence + "\n";
      if (a2.reflect) out += "- Reflection: " + a2.reflect + "\n";
      if (a2.bridge) out += "- Bridge: " + a2.bridge + "\n";
    }
  });
  return out;
}
function openPrintable(html){
  const w = window.open("", "_blank");
  if (!w) return false;
  w.document.write(html);
  w.document.close(); w.focus();
  setTimeout(()=>w.print(), 400);
  return true;
}

/* ============================================================
   Wiring
   ============================================================ */
function openScrim(id){ closeAll(); $(id).classList.add("open"); }
function closeAll(){ document.querySelectorAll(".scrim").forEach(s=>s.classList.remove("open")); }

function fillSelects(){
  $("sCountry").innerHTML = COUNTRIES.map(c=>'<option value="'+esc(c)+'">'+esc(c||"Not set")+'</option>').join("");
  $("sQA").innerHTML = Object.keys(QA_BODIES).map(k=>'<option value="'+k+'">'+esc(QA_BODIES[k])+'</option>').join("");
  $("qhelpBody").innerHTML = QHELP.map(([t,d])=>'<h4 style="font-family:var(--util);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin:14px 0 3px">'+esc(t)+'</h4><p class="hint" style="margin:0">'+esc(d)+'</p>').join("")
    + '<div class="note">None of this leaves your machine. The check is arithmetic and word matching, not AI, so it runs instantly, works with no internet, and gives the same answer every time.</div>';
}

function wire(){
  FIELDS.concat(RFIELDS, PFIELDS, AFIELDS).forEach(([id])=>{
    $(id).oninput = onEdit;
    if ($(id).tagName === "SELECT") $(id).onchange = onEdit;
  });
  $("courseTitle").oninput = onEdit;

  $("btnAddAct").onclick = ()=>{
    readForm();
    week().sequence.push({min:15, title:"New move", mode:"active", group:"pairs", notes:"", evidence:"", tech:false});
    paintActivities(); onEdit();
  };
  $("btnBalance").onclick = rebalance;
  $("btnLibrary").onclick = ()=>{ readForm(); if (!Object.keys(libOn).length) libOn = {fits:true}; paintLibrary(); openScrim("libScrim"); };
  $("libSearch").oninput = paintLibrary;

  $("btnAddWeek").onclick = ()=>{
    readForm();
    state.weeks.push(blankWeek(state.weeks.length+1, state.course.minutes));
    state.selected = state.weeks.length;
    paintWeek(); queueSave();
  };
  $("btnPrintWeek").onclick = ()=>{ readForm(); window.print(); };
  $("btnPrintAll").onclick = ()=>{
    readForm();
    if (!openPrintable(planDocument(state.weeks, true, true))) toast("Allow pop-ups, or use Export to save the plan");
  };

  /* dashboard and method */
  $("btnDash").onclick = ()=>{ readForm(); paintDash(); openScrim("dashScrim"); };
  $("btnDashPrint").onclick = ()=>{ if (!openPrintable(qaDocument())) toast("Allow pop-ups to print"); };
  $("btnQualityHelp").onclick = ()=> openScrim("qhelpScrim");

  /* import */
  $("btnImport").onclick = ()=>{ staged=null; rawText=""; $("preview").style.display="none"; $("importStatus").textContent=""; $("btnApply").disabled=true; openScrim("importScrim"); };
  $("btnPick").onclick = ()=> $("file").click();
  const takeFile = async f => {
    if (!f) return;
    $("fileName").textContent = "Reading " + f.name + "…";
    try { rawText = await extractText(f); $("fileName").textContent = f.name + " · " + rawText.length.toLocaleString() + " characters"; }
    catch(err){ $("fileName").textContent = err.message; }
  };
  $("file").onchange = e => takeFile(e.target.files[0]);
  const drop = $("drop");
  ["dragenter","dragover"].forEach(ev=>drop.addEventListener(ev, e=>{ e.preventDefault(); drop.classList.add("hot"); }));
  ["dragleave","drop"].forEach(ev=>drop.addEventListener(ev, e=>{ e.preventDefault(); drop.classList.remove("hot"); }));
  drop.addEventListener("drop", e=> takeFile(e.dataTransfer.files[0]));
  $("btnRead").onclick = readOutline;
  $("btnApply").onclick = applyImport;

  /* coach */
  $("btnCoach").onclick = ()=>{ readForm(); $("coachTitle").textContent = "Ideas for week " + pad(week().no); openScrim("coachScrim"); };
  $("btnCoachRun").onclick = runCoach;
  $("btnCoachCopyPersonal").onclick = ()=>{
    const txt = $("coachOut").value.trim();
    if (!txt) { toast("Nothing to send yet"); return; }
    readForm();
    const w = week();
    w.personal.notes = (w.personal.notes ? w.personal.notes + "\n\n" : "") + txt;
    paintWeek(); save(); closeAll(); toast("Added to your layer");
  };

  /* courses */
  $("btnCourses").onclick = ()=>{ readForm(); paintCourseList(); openScrim("coursesScrim"); };
  $("coursePicker").onchange = async e=>{
    const v = e.target.value;
    if (v === "__new") { paintPicker(); paintCourseList(); openScrim("coursesScrim"); $("newCourseName").focus(); return; }
    await switchCourse(v);
  };
  $("btnNewCourse").onclick = ()=>{
    const name = $("newCourseName").value.trim();
    if (!name) { toast("Give the course a title first"); return; }
    createCourse(name, parseInt($("newCourseWeeks").value,10) || 13);
    $("newCourseName").value = "";
  };
  $("btnDuplicate").onclick = duplicateCourse;

  /* draft a week */
  $("btnPlanWeek").onclick = ()=>{
    readForm();
    $("planEyebrow").textContent = "Week " + pad(week().no);
    $("planTitle").textContent = week().topic ? "Draft: " + week().topic : "Draft this week";
    $("planPreview").style.display = "none"; $("planStatus").textContent = "";
    $("btnPlanApply").disabled = true; draft = null;
    if (roomFor(week()) === "tiered" && $("planStyle").value === "active") $("planStyle").value = "lecturehall";
    if (state.course.tech === "none") $("planLowTech").checked = true;
    openScrim("planScrim");
  };
  $("btnPlanRun").onclick = async ()=>{
    readForm();
    const st = $("planStatus"), bar = $("planBar"), fill = bar.querySelector("i");
    if (!week().topic.trim()) { st.className = "status bad"; st.textContent = "Give the week a topic first, or import an outline."; return; }
    st.className = "status"; st.textContent = "Drafting…";
    bar.classList.add("on"); fill.style.width = "45%";
    $("btnPlanRun").disabled = true;
    try {
      draft = await draftWeek(week(), $("planContext").value, $("planStyle").value,
                              {local: $("planLocal").checked, lowTech: $("planLowTech").checked});
      paintDraft(draft);
      st.textContent = "Draft ready. Untick anything you do not want before applying.";
      $("btnPlanApply").disabled = false;
    } catch(e){
      st.className = "status bad";
      st.textContent = e.message + ". If this site is hosted without a server, paste an API key in Settings. Either way you can plan the week by hand — the move library and the quality check need no internet at all.";
    }
    fill.style.width = "100%";
    $("btnPlanRun").disabled = false;
  };
  $("btnPlanApply").onclick = ()=>{ if (draft) applyDraft(draft); };
  $("btnPlanAllEmpty").onclick = draftAllEmpty;

  /* export */
  $("btnWeekDownload").onclick = ()=>{
    readForm();
    $("exportTitle").textContent = "Download week " + pad(week().no);
    $("expScope").value = "week";
    openScrim("exportScrim");
  };
  $("btnExport").onclick = ()=>{
    readForm();
    $("exportTitle").textContent = "Download " + (state.course.title || "your plan");
    openScrim("exportScrim");
  };
  $("btnEachWeek").onclick = async ()=>{
    readForm();
    const ws = scopedWeeks($("expScope").value === "week" ? "all" : $("expScope").value);
    const mine = $("expPersonal").checked, q = $("expQuality").checked;
    for (const w of ws) {
      download(slug(state.course.title) + "-week-" + pad(w.no) + ".doc", planDocument([w], mine, q), "application/msword");
      await new Promise(r=>setTimeout(r, 400));
    }
    toast(plural(ws.length, "weekly plan") + " downloaded. Allow multiple downloads if your browser asks.");
  };
  const base = ()=> slug(state.course.title) + ($("expScope").value==="week" ? "-week-"+pad(week().no) : "");
  $("btnDocx").onclick = ()=> download(base()+".doc", currentPlanDoc(), "application/msword");
  $("btnPdf").onclick = ()=>{
    const doc = currentPlanDoc();
    download(base()+".html", doc, "text/html");
    if (!openPrintable(doc)) toast("Downloaded. Allow pop-ups if you also want the print dialogue.");
  };
  $("btnMd").onclick = ()=> download(base()+".md", toMarkdown(scopedWeeks($("expScope").value), $("expPersonal").checked), "text/markdown");
  $("btnCsv").onclick = ()=> download(slug(state.course.title)+"-outcome-map.csv", "﻿" + toCSV(scopedWeeks($("expScope").value)), "text/csv");
  $("btnQA").onclick = ()=>{
    readForm();
    download(slug(state.course.title)+"-quality-dossier.doc", qaDocument(), "application/msword");
    toast("Dossier downloaded. It opens in Word so you can move the evidence under your own body's headings.");
  };
  $("btnJson").onclick = ()=> download(slug(state.course.title)+"-activecourse.json", JSON.stringify(state,null,2), "application/json");
  $("btnJsonAll").onclick = async ()=>{
    readForm(); await save();
    const all = [];
    for (const c of library.courses) {
      const raw = await store.get(cKey(c.id));
      if (raw) { try { all.push(JSON.parse(raw)); } catch(e){} }
    }
    download("activecourse-all-courses.json", JSON.stringify({activecourse:"library", courses:all}, null, 2), "application/json");
  };
  $("restoreFile").onchange = async e=>{
    const f = e.target.files[0]; if (!f) return;
    try {
      const d = JSON.parse(await f.text());
      const docs = Array.isArray(d.courses) && d.activecourse === "library" ? d.courses : [d];
      readForm(); await save();
      let n = 0;
      for (const doc of docs) {
        if (!doc || !Array.isArray(doc.weeks)) continue;
        state = hydrate(doc);
        state.id = newId();
        await save();
        n++;
      }
      if (!n) throw new Error("bad file");
      paintCourse(); paintWeek(); paintCourseList();
      toast(n === 1 ? "Course added" : n + " courses added");
    } catch(err){ toast("That file is not an ActiveCourse backup"); }
    e.target.value = "";
  };

  /* settings */
  $("btnSettings").onclick = ()=>{
    const c = state.course;
    $("sCode").value = c.code||""; $("sTerm").value = c.term||"";
    $("sLevel").value = c.level||""; $("sInstitution").value = c.institution||"";
    $("sCountry").value = c.country||""; $("sQA").value = c.qa||"";
    $("sMinutes").value = c.minutes||90; $("sSize").value = c.size||35;
    $("sRoom").value = c.room||"flat"; $("sTech").value = c.tech||"patchy";
    $("sPLO").value = c.plos||"";
    $("sKey").value = library.settings.apiKey||"";
    openScrim("settingsScrim");
  };
  const SETTING_IDS = ["sCode","sTerm","sLevel","sInstitution","sCountry","sQA","sMinutes","sSize","sRoom","sTech","sPLO","sKey"];
  const readSettings = ()=>{
    const c = state.course;
    c.code = $("sCode").value; c.term = $("sTerm").value; c.level = $("sLevel").value;
    c.institution = $("sInstitution").value; c.country = $("sCountry").value; c.qa = $("sQA").value;
    c.minutes = clamp(parseInt($("sMinutes").value,10) || 90, 20, 300);
    c.size = clamp(parseInt($("sSize").value,10) || 35, 1, 2000);
    c.room = $("sRoom").value; c.tech = $("sTech").value; c.plos = $("sPLO").value;
    library.settings.apiKey = $("sKey").value.trim();
    paintCourse(); paintRibbon(); paintQuality(); paintRail(); queueSave();
  };
  SETTING_IDS.forEach(id=>{ $(id).oninput = readSettings; $(id).onchange = readSettings; });

  $("btnWipe").onclick = async ()=>{
    if (!confirm("Clear every week in " + (state.course.title||"this course") + "? Your other courses are not touched. Download a backup first if you want to keep it.")) return;
    const keep = Object.assign({}, state.course);
    const n = state.weeks.length;
    const id = state.id;
    state = freshState(keep.title, n);
    state.id = id; state.course = keep;
    state.weeks = Array.from({length:n},(_,i)=>blankWeek(i+1, keep.minutes));
    await save();
    paintCourse(); paintWeek(); closeAll(); toast("Weeks cleared");
  };

  /* scrim close and shortcuts */
  document.querySelectorAll("[data-close]").forEach(b=>b.onclick = closeAll);
  document.querySelectorAll(".scrim").forEach(s=>s.addEventListener("click", e=>{ if (e.target===s) closeAll(); }));
  document.addEventListener("keydown", e=>{
    if (e.key === "Escape") return closeAll();
    if ((e.altKey || e.metaKey) && (e.key === "ArrowLeft" || e.key === "ArrowRight")) {
      e.preventDefault();
      selectWeek(state.selected + (e.key === "ArrowRight" ? 1 : -1));
    }
  });
  window.addEventListener("beforeunload", ()=>{ readForm(); });
}

(async function start(){
  await load();
  fillSelects();
  wire();
  paintCourse();
  paintWeek();
  $("savedFlag").textContent = "Saved";
})();
