  const profiles = ws.map(timeProfile);
  const scores = ws.map(w => (w.topic||"").trim() ? analyse(w).score : null);
  const maxMin = Math.max(target, ...profiles.map(p=>p.total)) || target;

  const stack = '<div class="bars">' + profiles.map((p,i)=>{
    const h = v => (v/maxMin*94).toFixed(1) + "px";
    return '<div class="col" title="Week '+(i+1)+': '+p.work+' min working, '+p.listen+' min listening, '+p.frame+' min framing">'
      + '<div class="b" style="height:'+h(p.frame)+';background:'+MODES.close.color+'"></div>'
