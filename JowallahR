  } catch(e){
    st.className = "status bad";
    st.textContent = e.message + ". If this site is hosted without a server, paste an API key in Settings. Everything else in the planner keeps working without one.";
  }
  fill.style.width = "100%";
  $("btnCoachRun").disabled = false;
}

