const STYLES = {
  active:"Mixed active learning: pairs, small groups, and individual work.",
  discussion:"Seminar style: structured discussion, text-based argument, whole-group synthesis.",
  problem:"Problem-based: students work real cases or problems for most of the class.",
  studio:"Studio or workshop: students build, draft, or make something during the session.",
  flipped:"Flipped: readings done beforehand, class time spent applying and troubleshooting.",
  lecturehall:"Large lecture hall with fixed tiered seats: use only moves that survive scale — voting, pairs along a row, numbered heads, written slips, board relay. Never assume students can move around."
};
function planPrompt(w, context, style, opts){
  const p = w.personal || {};
  const r = w.room || {};
  return [
    contextBlock(w, opts),
    "Approach: " + (STYLES[style] || STYLES.active),
    "",
    "Week " + w.no + " topic: " + (w.topic || "not set"),
    w.question ? "Existing essential question: " + w.question : "",
    w.objectives ? "Objectives from the outline:\n" + w.objectives : "No objectives given; propose them from the topic.",
    w.readings ? "Readings:\n" + w.readings : "",
    w.assessment ? "Assessment in play: " + w.assessment : "",
    w.concepts ? "Known sticking points: " + w.concepts : "",
    r.groups ? "How groups are formed in this room: " + r.groups : "",
    p.hook ? "Lecturer's planned hook: " + p.hook : "",
    p.local ? "Local examples the lecturer wants used: " + p.local : "",
    p.adapt ? "Adjustments needed for this group: " + p.adapt : "",
    context ? "Also: " + context : "",
    opts && opts.local ? "\n" + CARIB_RULE : ""
  ].filter(Boolean).join("\n");
