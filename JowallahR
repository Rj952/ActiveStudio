  const scoreBars = '<div class="bars">' + scores.map((s,i)=>{
    const col = s == null ? "#D9E2DC" : s >= 85 ? MODES.open.color : s >= 70 ? MODES.check.color : s >= 50 ? "#C79A4E" : "#A2402C";
