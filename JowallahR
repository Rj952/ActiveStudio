async function extractText(file){
  const name = file.name.toLowerCase();
  if (name.endsWith(".docx")) {
    await loadScript("https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js");
    if (!window.mammoth) throw new Error("Word reader could not load. Paste the text instead.");
    const buf = await file.arrayBuffer();
    const res = await window.mammoth.extractRawText({arrayBuffer:buf});
    return res.value;
  }
  if (name.endsWith(".pdf")) {
    await loadScript("https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js");
    if (!window.pdfjsLib) throw new Error("PDF reader could not load. Paste the text instead.");
    window.pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
    const buf = await file.arrayBuffer();
    const doc = await window.pdfjsLib.getDocument({data:buf}).promise;
    let out = "";
    for (let p=1; p<=doc.numPages; p++){
      const page = await doc.getPage(p);
      const c = await page.getTextContent();
      out += c.items.map(i=>i.str).join(" ") + "\n\n";
    }
    return out;
  }
  return await file.text();
}
function loadScript(src){
  return new Promise((resolve,reject)=>{
    if ([...document.scripts].some(s=>s.src===src)) return resolve();
    const s = document.createElement("script");
    s.src = src; s.onload = ()=>resolve(); s.onerror = ()=>reject(new Error("Could not load " + src));
    document.head.appendChild(s);
  });
}

const WEEK_RE = /^\s*(?:week|unit|module|session|topic|class|lesson)\s*[:.\-]?\s*(\d{1,2})\b[:.\-\s]*(.*)$/i;
function segment(text){
  const src = text.replace(/\r/g,"").split("\n");
  const segs = []; let cur = null;
  src.forEach(line=>{
    const m = line.match(WEEK_RE);
    if (m) {
      cur = {no: parseInt(m[1],10), heading: (m[2]||"").trim(), body: []};
      segs.push(cur);
    } else if (cur) {
      cur.body.push(line);
    }
  });
  return segs.map(s=>({no:s.no, heading:s.heading, body:s.body.join("\n").trim()}))
             .filter(s=>s.heading || s.body);
}
const LABEL_RE = /^\s*(?:learning|required|core|key|essential|suggested|recommended|primary|weekly|set)?\s*(objectives?|outcomes?|aims?|readings?|resources?|texts?|materials?|assessments?|assignments?|deliverables?|tasks?|activities|topics?|focus|overview|description|questions?)\s*[:\-–]\s*(.*)$/i;
function classify(word){
  const w = word.toLowerCase();
  if (/objectiv|outcome|aim/.test(w)) return "objectives";
  if (/read|resource|text|material/.test(w)) return "readings";
  if (/assess|assign|deliver|task/.test(w)) return "assessment";
  if (/question/.test(w)) return "question";
  return null;
}
function patternParse(seg){
  const buckets = {objectives:[], readings:[], assessment:[], question:[]};
  let cur = null;
  (seg.body||"").split("\n").forEach(line=>{
    const m = line.match(LABEL_RE);
    if (m) {
      cur = classify(m[1]);
      const rest = (m[2]||"").trim();
      if (cur && rest) buckets[cur].push(rest);
      return;
    }
    const b = line.replace(/^\s*[-•*•–]+\s*|^\s*\d{1,2}[.)]\s+/,"").trim();
    if (!b) { cur = null; return; }
    if (cur) buckets[cur].push(b);
  });
  return {
    topic: seg.heading || firstMeaningful(seg.body) || "",
    question: buckets.question.join(" "),
    objectives: buckets.objectives.join("\n"),
    readings: buckets.readings.join("\n"),
    assessment: buckets.assessment.join("\n")
  };
}
function firstMeaningful(body){
  const ls = (body||"").split("\n").map(s=>s.trim()).filter(Boolean);
  for (const l of ls) {
    const m = l.match(/^(?:topic|focus|theme|overview|title)\s*[:\-–]\s*(.+)$/i);
    if (m) return m[1].slice(0,120);
  }
  const first = ls[0] || "";
  return first.replace(/^[-•*•]\s*/,"").slice(0,120);
}

/* ============================================================
   Talking to Claude
   Deployed, calls go to /api/claude and the key lives on the server.
   Opened as a local file, it falls back to a direct call with the key
   from Settings.
   ============================================================ */
async function callClaude(system, prompt, maxTokens){
  const body = JSON.stringify({
    model:"claude-sonnet-4-6",
    max_tokens: maxTokens || 1000,
    system: system,
    messages:[{role:"user", content: prompt}]
  });
  let data = null, serverSaid = "";

  if (typeof location !== "undefined" && /^https?:/.test(location.protocol)) {
    try {
      const r = await fetch("/api/claude", {method:"POST", headers:{"Content-Type":"application/json"}, body});
      const ct = r.headers.get("content-type") || "";
      if (r.ok && ct.indexOf("json") > -1) {
        data = await r.json();
      } else if (ct.indexOf("json") > -1) {
        const j = await r.json().catch(()=>({}));
        serverSaid = j.error || "";
      }
    } catch(e) { /* no proxy here, try direct */ }
  }

  if (!data) {
    const headers = {"Content-Type":"application/json"};
    const k = (library.settings.apiKey||"").trim();
    if (k) {
      headers["x-api-key"] = k;
      headers["anthropic-version"] = "2023-06-01";
      headers["anthropic-dangerous-direct-browser-access"] = "true";
    }
    let res;
    try { res = await fetch("https://api.anthropic.com/v1/messages", {method:"POST", headers, body}); }
    catch(e) { throw new Error(serverSaid || "Claude could not be reached from here"); }
    if (!res.ok) throw new Error(serverSaid || ("Claude is not reachable from here (" + res.status + ")"));
    data = await res.json();
  }
  return (data.content||[]).filter(b=>b.type==="text").map(b=>b.text).join("\n");
}
function parseJSONish(txt){
  let t = String(txt||"").trim().replace(/^```(?:json)?/i,"").replace(/```$/,"").trim();
  const a = t.indexOf("{"), b = t.lastIndexOf("}");
  if (a > 0 || b < t.length-1) { if (a>=0 && b>a) t = t.slice(a,b+1); }
  return JSON.parse(t);
}

