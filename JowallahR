  if (parts.includes("concepts") && p.concepts) w.concepts = p.concepts;
  if (parts.includes("exit") && p.exit) w.exit = p.exit;
  if (parts.includes("sequence") && p.sequence.length) w.sequence = p.sequence;
  if (parts.includes("fallback") && p.fallback) w.room.fallback = p.fallback;
