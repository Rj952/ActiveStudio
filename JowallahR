<script>
/* ============================================================
   ActiveCourse Studio
   A week-by-week planner for Caribbean higher education:
   active learning, constructive alignment, face-to-face quality.
   Single file. No build step. Everything except the AI works offline.
   ============================================================ */

const IDX = "activecourse-index";
const OLD = "activecourse-v2";
const cKey = id => "activecourse:course:" + id;

const MODES = {
  open:   {label:"Open",   color:"#1C6B5B", kind:"frame",  blurb:"settles the room and surfaces what they already carry"},
  input:  {label:"Input",  color:"#9DB6AE", kind:"listen", blurb:"you are talking, they are receiving"},
  active: {label:"Active", color:"#A96A12", kind:"work",   blurb:"they are doing the thinking, out loud or on paper"},
  apply:  {label:"Apply",  color:"#C79A4E", kind:"work",   blurb:"they use it on a real problem, case or artefact"},
  check:  {label:"Check",  color:"#134A3F", kind:"work",   blurb:"you find out what actually landed"},
  close:  {label:"Close",  color:"#63756F", kind:"frame",  blurb:"they consolidate and you collect evidence"}
};
const GROUPS = {
  whole:      "Whole class",
  pairs:      "Pairs",
  small:      "Small groups",
  individual: "Individual",
  circulate:  "You circulate"
};
const ROOMS = {
  flat:"Flat room, movable chairs", tiered:"Tiered theatre, fixed seats",
  seminar:"Seminar room", lab:"Laboratory or studio", field:"Off campus or field"
};
const TECHS = {
  good:"Projector and internet usually fine", patchy:"Projector yes, internet patchy", none:"Board and paper only"
};
const COUNTRIES = ["","Anguilla","Antigua and Barbuda","Aruba","Bahamas","Barbados","Belize","Bermuda","British Virgin Islands","Cayman Islands","Cuba","Curacao","Dominica","Dominican Republic","Grenada","Guyana","Haiti","Jamaica","Montserrat","Puerto Rico","St Kitts and Nevis","St Lucia","St Vincent and the Grenadines","Sint Maarten","Suriname","Trinidad and Tobago","Turks and Caicos","US Virgin Islands","Other Caribbean","Outside the Caribbean"];
const QA_BODIES = {
  "":"Not set",
  ucj:"University Council of Jamaica (UCJ)",
  actt:"Accreditation Council of Trinidad and Tobago (ACTT)",
  bac:"Barbados Accreditation Council (BAC)",
  gnab:"Guyana National Accreditation Council",
  bznaes:"Belize / other national body",
  uwi:"UWI internal quality assurance",
  cqf:"CARICOM Qualifications Framework alignment",
  canqate:"CANQATE member institution",
  other:"Other or generic quality framework"
};

/* Bloom's, in the revised order. Verbs are matched on the first word of an objective. */
const BLOOM = [
  {key:"remember",  label:"Remember",  rank:1, verbs:["define","list","name","recall","identify","state","label","recognise","recognize","match","repeat","record","locate","cite"]},
  {key:"understand",label:"Understand",rank:2, verbs:["explain","describe","summarise","summarize","interpret","classify","discuss","illustrate","paraphrase","outline","restate","report","review","translate","exemplify"]},
  {key:"apply",     label:"Apply",     rank:3, verbs:["apply","use","demonstrate","calculate","solve","implement","execute","operate","carry","perform","practise","practice","compute","employ","conduct","administer","model"]},
  {key:"analyse",   label:"Analyse",   rank:4, verbs:["analyse","analyze","differentiate","compare","contrast","examine","deconstruct","investigate","distinguish","categorise","categorize","diagnose","attribute","trace","map","test"]},
  {key:"evaluate",  label:"Evaluate",  rank:5, verbs:["evaluate","critique","judge","assess","justify","defend","appraise","argue","recommend","prioritise","prioritize","rank","validate","weigh","select"]},
  {key:"create",    label:"Create",    rank:6, verbs:["create","design","develop","compose","construct","formulate","plan","devise","generate","produce","synthesise","synthesize","build","write","propose","adapt","invent","curate"]}
];
const STOP_STEMS = /^(?:students?\s+(?:will\s+be\s+able\s+to|will|should\s+be\s+able\s+to|should|can)\s+|by\s+the\s+end[^,]*,\s*|learners?\s+(?:will\s+be\s+able\s+to|will|should)\s+|be\s+able\s+to\s+|to\s+)/i;

/* ---------- storage: Claude artifact storage, else this browser ---------- */
const store = {
  async get(k){
    if (window.storage && window.storage.get) {
      try { const r = await window.storage.get(k); return r ? r.value : null; } catch(e) {}
    }
    try { return localStorage.getItem(k); } catch(e) { return null; }
  },
  async set(k,v){
    if (window.storage && window.storage.set) {
      try { await window.storage.set(k,v); return true; } catch(e) {}
    }
    try { localStorage.setItem(k,v); return true; } catch(e) { return false; }
  },
  async del(k){
    if (window.storage && window.storage.delete) {
      try { await window.storage.delete(k); } catch(e) {}
    }
    try { localStorage.removeItem(k); } catch(e) {}
  }
};

/* ---------- model ---------- */
function blankSequence(total){
  const t = total || 90;
  const r = n => Math.max(5, Math.round(t*n/5)*5);
  return [
    {min:r(0.10), title:"Opening: surface what they already think", mode:"open",   group:"pairs",      notes:"", evidence:"", tech:false},
    {min:r(0.20), title:"Mini-input on the core idea",              mode:"input",  group:"whole",      notes:"", evidence:"", tech:true},
    {min:r(0.30), title:"Active learning task",                     mode:"active", group:"small",      notes:"", evidence:"", tech:false},
    {min:r(0.25), title:"Apply it to a case or problem",            mode:"apply",  group:"small",      notes:"", evidence:"", tech:false},
    {min:r(0.15), title:"Synthesis and exit ticket",                mode:"close",  group:"individual", notes:"", evidence:"", tech:false}
  ];
}
function blankWeek(n, total){
  return {
    no:n, topic:"", question:"", objectives:"", readings:"", assessment:"", concepts:"",
    sequence: blankSequence(total), exit:"",
    room:{seats:"", room:"", groups:"", fallback:""},
    personal:{hook:"",local:"",adapt:"",materials:"",notes:""},
    after:{notes:"",evidence:"",reflect:"",bridge:""},
    imported:null
  };
}
function newId(){ return "c" + Date.now().toString(36) + Math.random().toString(36).slice(2,6); }
function blankCourse(title){
  return {title:title||"", code:"", term:"", level:"", institution:"", country:"", qa:"",
          minutes:90, size:35, room:"flat", tech:"patchy", plos:""};
}
function freshState(title, weeks){
  const n = Math.min(52, Math.max(1, weeks || 13));
  return {
    id: newId(),
    course: blankCourse(title),
    weeks: Array.from({length:n},(_,i)=>blankWeek(i+1,90)),
    selected:1
  };
}
let library = {courses:[], current:null, settings:{apiKey:""}};
let state = freshState();
let staged = null;
let rawText = "";

/* ---------- helpers ---------- */
const $ = id => document.getElementById(id);
const esc = s => String(s==null?"":s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const week = () => state.weeks[state.selected-1];
const lines = v => String(v||"").split("\n").map(s=>s.trim()).filter(Boolean);
const pad = n => String(n).padStart(2,"0");
const clamp = (n,a,b) => Math.min(b, Math.max(a, n));
const plural = (n, one, many) => n + " " + (n === 1 ? one : (many || one + "s"));
let toastTimer;
function toast(msg){
  const t = $("toast"); t.textContent = msg; t.classList.add("on");
  clearTimeout(toastTimer); toastTimer = setTimeout(()=>t.classList.remove("on"), 3200);
}
/* the room and size that actually apply to a given week */
function seatsFor(w){ return parseInt(w.room && w.room.seats, 10) || parseInt(state.course.size,10) || 35; }
function roomFor(w){ return (w.room && w.room.room) || state.course.room || "flat"; }

/* ---------- save / load ---------- */
let saveTimer, saving = false;
function queueSave(){
  $("savedFlag").textContent = "Saving";
  clearTimeout(saveTimer);
  saveTimer = setTimeout(save, 500);
}
async function save(){
  if (saving) return;
  saving = true;
  const entry = library.courses.find(c=>c.id===state.id);
  const stamp = new Date().toISOString();
  const summary = {
    id:state.id, title:state.course.title||"Untitled course", code:state.course.code||"",
    term:state.course.term||"", weeks:state.weeks.length, updated:stamp
  };
  if (entry) Object.assign(entry, summary); else library.courses.push(summary);
  library.current = state.id;
  const a = await store.set(cKey(state.id), JSON.stringify(state));
  const b = await store.set(IDX, JSON.stringify(library));
  saving = false;
  $("savedFlag").textContent = (a && b) ? "Saved" : "Not saved";
  paintPicker();
}
/* fill in anything a saved or imported course document is missing */
function hydrate(d){
  const s = {id: d.id || newId(), selected: 1};
  s.course = Object.assign(blankCourse(), d.course||{});
  s.course.minutes = clamp(parseInt(s.course.minutes,10)||90, 20, 300);
  s.course.size = clamp(parseInt(s.course.size,10)||35, 1, 2000);
  if (!ROOMS[s.course.room]) s.course.room = "flat";
  if (!TECHS[s.course.tech]) s.course.tech = "patchy";
  const src = Array.isArray(d.weeks) && d.weeks.length ? d.weeks : freshState().weeks;
  s.weeks = src.map((w,i)=>{
    const b = blankWeek(i+1, s.course.minutes);
    const m = Object.assign(b, w);
    m.room = Object.assign(b.room, w.room||{});
    m.personal = Object.assign(b.personal, w.personal||{});
    m.after = Object.assign(b.after, w.after||{});
    if (!Array.isArray(m.sequence) || !m.sequence.length) m.sequence = blankSequence(s.course.minutes);
    m.sequence = m.sequence.map(a=>({
      min: Math.max(0, parseInt(a.min,10)||0),
      title: String(a.title||"Untitled move"),
      mode: MODES[a.mode] ? a.mode : "active",
      group: GROUPS[a.group] ? a.group : "whole",
      notes: String(a.notes||""),
      evidence: String(a.evidence||""),
      tech: !!a.tech
    }));
    m.no = i+1;
    return m;
  });
  s.selected = clamp(parseInt(d.selected,10)||1, 1, s.weeks.length);
  return s;
}
async function loadCourse(id){
  const raw = await store.get(cKey(id));
  if (!raw) return false;
  try { state = hydrate(JSON.parse(raw)); state.id = id; return true; }
  catch(e){ console.warn("Could not read course", e); return false; }
}
async function load(){
  const rawIdx = await store.get(IDX);
  if (rawIdx) {
    try {
      const d = JSON.parse(rawIdx);
      library.courses = Array.isArray(d.courses) ? d.courses : [];
      library.current = d.current || (library.courses[0] && library.courses[0].id);
      library.settings = Object.assign({apiKey:""}, d.settings||{});
    } catch(e){}
  }
  if (!library.courses.length) {
    const legacy = await store.get(OLD);
    if (legacy) {
      try {
        const d = JSON.parse(legacy);
        if (d && Array.isArray(d.weeks) && d.weeks.length) {
          state = hydrate(d);
          library.settings.apiKey = (d.settings && d.settings.apiKey) || "";
          await save();
          await store.del(OLD);
          return;
        }
      } catch(e){}
    }
  }
  if (library.current && await loadCourse(library.current)) return;
  if (library.courses.length && await loadCourse(library.courses[0].id)) return;
  state = freshState();
  await save();
}
async function switchCourse(id){
  if (id === state.id) return;
  readForm(); await save();
  if (await loadCourse(id)) {
    library.current = id;
    await store.set(IDX, JSON.stringify(library));
    paintCourse(); paintWeek(); paintPicker();
    toast("Now editing " + (state.course.title || "your course"));
  }
}
async function createCourse(title, weeks){
  readForm(); await save();
  const carry = state.course;
  state = freshState(title, weeks);
  /* a lecturer's room, size and country rarely change between their own courses */
  Object.assign(state.course, {
    country:carry.country, institution:carry.institution, qa:carry.qa,
    minutes:carry.minutes, size:carry.size, room:carry.room, tech:carry.tech
  });
  state.weeks = state.weeks.map((w,i)=>blankWeek(i+1, state.course.minutes));
  await save();
  paintCourse(); paintWeek(); closeAll();
  toast("Course created. Import an outline, or start typing into week one.");
}
async function duplicateCourse(){
  readForm();
  const copy = JSON.parse(JSON.stringify(state));
  await save();
  copy.id = newId();
  copy.course.title = (copy.course.title || "Untitled course") + " (copy)";
  state = copy;
  await save();
  paintCourse(); paintWeek(); closeAll();
  toast("Duplicated");
}
async function deleteCourse(id){
  const entry = library.courses.find(c=>c.id===id);
  if (!entry) return;
  if (!confirm("Delete " + (entry.title||"this course") + " and all its weeks? Download a backup first if you want to keep it.")) return;
  library.courses = library.courses.filter(c=>c.id!==id);
  await store.del(cKey(id));
  if (id === state.id) {
    if (library.courses.length) { await loadCourse(library.courses[0].id); }
    else { state = freshState(); }
  }
  await save();
  paintCourse(); paintWeek(); paintCourseList();
  toast("Deleted");
}

