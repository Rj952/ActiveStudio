  + "Use the outline's own topics in their given order. Do not invent extra content.";

async function readOutline(){
  const useAI = $("useAI").checked;
  const status = $("importStatus"), bar = $("bar"), fill = bar.querySelector("i");
  status.className = "status"; status.textContent = "Reading…";
  bar.classList.add("on"); fill.style.width = "6%";
  $("btnApply").disabled = true;

  try {
    if (!rawText.trim()) rawText = $("pasteText").value;
    if (!rawText.trim()) throw new Error("Add a file or paste the outline text first.");

    let segs = segment(rawText);
    let results = [];

    if (!segs.length) {
      if (useAI) {
        status.textContent = "No week headings found. Asking Claude to propose a sequence…";
        const out = await callClaude(SPLIT_SYSTEM, rawText.slice(0,6000), 1000);
        const j = parseJSONish(out);
        results = (j.weeks||[]).map((w,i)=>({no:w.no||i+1, topic:w.topic||"", question:"", objectives:"", readings:"", assessment:"", how:"claude"}));
      }
      if (!results.length) throw new Error("No weeks found. Label sections as Week 1, Unit 1, or Module 1, then read again.");
    } else {
      for (let i=0;i<segs.length;i++){
        const seg = segs[i];
        let row = patternParse(seg); row.how = "pattern";
        if (useAI && $("useAI").checked) {
          status.textContent = "Structuring week " + seg.no + " of " + segs.length + "…";
          try { row = Object.assign(row, await structureSegment(seg), {how:"claude"}); }
          catch(e){ status.textContent = "Claude unavailable, reading by pattern instead…"; $("useAI").checked = false; }
        }
        row.no = seg.no || (i+1);
        results.push(row);
        fill.style.width = (8 + 88*(i+1)/segs.length) + "%";
      }
    }

    results.sort((a,b)=>a.no-b.no);
    results.forEach((r,i)=>r.no=i+1);
    staged = results;
    fill.style.width = "100%";
    status.textContent = plural(results.length, "week") + " read. Check them, then build.";
    showPreview(results);
    $("btnApply").disabled = false;
  } catch(err){
    status.className = "status bad";
    status.textContent = err.message || String(err);
    bar.classList.remove("on");
  }
}
function showPreview(rows){
  const p = $("preview");
  p.style.display = "block";
  p.innerHTML = rows.map(r=>{
    const counts = [];
    if (r.objectives) counts.push(lines(r.objectives).length + " obj");
    if (r.readings) counts.push(lines(r.readings).length + " read");
    if (r.assessment) counts.push("assessment");
    return '<div class="prow"><span class="n">W'+pad(r.no)+'</span><span>'+esc(r.topic||"Untitled")+'</span>'
      + '<span class="meta">'+(counts.join(" · ")||"topic only")+'</span></div>';
  }).join("");
}
function applyImport(){
  if (!staged) return;
  const keep = $("keepExisting").checked;
  const when = new Date().toLocaleDateString();
  const old = state.weeks;
  state.weeks = staged.map((r,i)=>{
    const prev = old[i];
    const w = blankWeek(i+1, state.course.minutes);
    if (keep && prev) {
      w.personal = prev.personal;
      w.after = prev.after;
      w.room = prev.room;
      w.exit = prev.exit;
      w.concepts = prev.concepts;
      if (prev.sequence && prev.sequence.some(a=>a.notes)) w.sequence = prev.sequence;
    }
    w.topic = r.topic || "";
    w.question = r.question || (keep && prev ? prev.question : "");
    w.objectives = r.objectives || "";
    w.readings = r.readings || "";
    w.assessment = r.assessment || "";
    w.imported = {topic:w.topic, question:w.question, objectives:w.objectives, readings:w.readings, assessment:w.assessment, when:when};
    return w;
  });
  state.selected = 1;
  staged = null; rawText = "";
  closeAll();
  paintCourse(); paintWeek(); save();
  toast(plural(state.weeks.length, "week") + " built. Your layer and your room notes are untouched.");
}

