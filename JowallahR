    + (noVerb ? '<div class="hbar"><span style="color:var(--rust)">No verb</span><span class="track"><i style="width:'+(noVerb/maxB*100).toFixed(0)+'%;background:var(--rust)"></i></span><span class="n">'+noVerb+'</span></div>' : "");
  const higher = counts.apply + counts.analyse + counts.evaluate + counts.create;
  const bloomNote = !totalObj ? "No objectives written yet."
    : Math.round(higher/totalObj*100) + "% of objectives sit at apply level or above."
      + (higher/totalObj < 0.5 ? " A programme that mostly asks students to explain things produces graduates who can explain things." : "");

  /* assessment load */
  const load = ws.map(w=>lines(w.assessment).length);
  const maxL = Math.max(1, ...load);
  const loadBars = '<div class="bars">' + load.map((n,i)=>
    '<div class="col" title="Week '+(i+1)+': '+n+' assessment item'+(n===1?"":"s")+'">'
    + '<div class="b" style="height:'+(n/maxL*94).toFixed(1)+'px;background:'+(n>=3?"#A2402C":n===2?"#C79A4E":MODES.check.color)+'"></div></div>').join("")
    + '</div><div class="xlabels">' + ws.map((w,i)=>'<span>'+(i+1)+'</span>').join("") + '</div>';
  const pileups = load.map((n,i)=>({n,i})).filter(x=>x.n>=3).map(x=>"week "+(x.i+1));
  const loadNote = pileups.length
    ? "Three or more items land in " + pileups.join(", ") + ". Students feel that as one bad fortnight, not as several courses."
    : (load.reduce((a,b)=>a+b,0) ? "Assessment is spread across the term." : "No assessment items recorded yet.");

  /* readings */
  const reads = ws.map(w=>lines(w.readings).length);
  const maxR = Math.max(1, ...reads);
  const readBars = '<div class="bars">' + reads.map((n,i)=>
    '<div class="col" title="Week '+(i+1)+': '+n+' reading'+(n===1?"":"s")+'">'
    + '<div class="b" style="height:'+(n/maxR*94).toFixed(1)+'px;background:'+MODES.open.color+'"></div></div>').join("")
    + '</div><div class="xlabels">' + ws.map((w,i)=>'<span>'+(i+1)+'</span>').join("") + '</div>';

  /* headline numbers */
  const totalMin = profiles.reduce((s,p)=>s+p.total,0);
  const workMin = profiles.reduce((s,p)=>s+p.work,0);
  const listenMin = profiles.reduce((s,p)=>s+p.listen,0);
  const done = scores.filter(s=>s!=null);
  const avgScore = done.length ? Math.round(done.reduce((a,b)=>a+b,0)/done.length) : 0;
  const evidenceWeeks = ws.filter(w=>(w.exit||"").trim() || (w.sequence||[]).some(a=>(a.evidence||"").trim())).length;
  const localWeeks = ws.filter(w=>(w.personal.local||"").trim()).length;
