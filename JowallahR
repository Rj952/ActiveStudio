function normalizePlan(j, target){
  const arr = v => Array.isArray(v) ? v.filter(Boolean).map(x=>String(x).trim()).join("\n") : String(v||"").trim();
  let seq = Array.isArray(j.sequence) ? j.sequence.map(a=>({
    min: Math.max(0, Math.round(Number(a.min)||0)),
    title: String(a.title||"Untitled move").trim(),
    mode: MODES[a.mode] ? a.mode : "active",
    group: GROUPS[a.group] ? a.group : "whole",
    notes: String(a.notes||"").trim(),
    evidence: String(a.evidence||"").trim(),
    tech: false
  })).filter(a=>a.title) : [];
  const total = seq.reduce((s,a)=>s+a.min,0);
  if (seq.length && total && Math.abs(total-target) > 1) {
    let running = 0;
    seq = seq.map((a,i)=>{
      const m = i === seq.length-1 ? Math.max(0, target-running) : Math.max(5, Math.round(a.min*target/total/5)*5);
      running += m;
      return Object.assign({}, a, {min: m});
    });
  }
  return {
    question: String(j.question||"").trim(),
    objectives: arr(j.objectives),
    concepts: String(j.concepts||"").trim(),
    sequence: seq,
    exit: String(j.exit||"").trim(),
    fallback: String(j.fallback||"").trim()
  };
}
async function draftWeek(w, context, style, opts){
