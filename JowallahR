      + '<div class="b" style="height:'+((s==null?4:s)/100*94).toFixed(1)+'px;background:'+col+'"></div></div>';
  }).join("") + '</div><div class="xlabels">' + ws.map((w,i)=>'<span>'+(i+1)+'</span>').join("") + '</div>';

  /* Bloom's across the whole course */
  const counts = {};
  BLOOM.forEach(b=>counts[b.key]=0);
